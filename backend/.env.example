PORT=5000
# Single origin, or comma-separated list (e.g. Netlify default domain + your custom domain):
# FRONTEND_URL=https://readspace.netlify.app,https://www.readspace.in
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@readspace.in
ADMIN_PASSWORD=admin123
ADMIN_SECRET_TOKEN=readspace-admin-secret-2025
JWT_SECRET=readspace_jwt_super_secret_key_2025
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/readspace?retryWrites=true&w=majority

# ── EMAIL (for Admin "Forgot Password") ──────────────────────
# Needed so the admin can receive a password-reset link if they forget it.
# Easiest option: a Gmail account with an "App Password" (not your normal
# Gmail password) — Google Account → Security → 2-Step Verification →
# App passwords → generate one for "Mail", then paste it as SMTP_PASS below.
# Any other SMTP provider (SendGrid, Mailgun, Zoho, your host's email, etc.)
# works too — just fill in its host/port/user/pass instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=youraddress@gmail.com

